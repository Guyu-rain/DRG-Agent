# 虚拟文档系统 —— 所有本地产物统一收纳于根目录 documents/ 下并透明可见。
# 仅忽略体积较大的二进制导出 (xlsx)，保留目录结构与生成的 Markdown 文档。
documents/exports/*.xlsx
# 旧的存储位置 (已作废，统一迁移至根目录 documents/)
server/documents/

# Runtime PID files
.run/

# DRG file
file/
.file/

# Example cases (generated from scripts, not source)
example/

# uv cache
.uv-cache/

# claude
.claude/server/data/rules/import_*.json

# Extraction scripts (utility tooling)
scripts/
